# Que el móvil reconozca el .vcf como contacto y ofrezca "Añadir a contactos"
AddType text/vcard;charset=utf-8 .vcf
<IfModule mod_headers.c>
<FilesMatch "\.vcf$">
  Header set Content-Disposition "attachment; filename=\"contacto.vcf\""
</FilesMatch>
</IfModule>

# Compresión y caché para carga instantánea
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/vcard
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
